APP_NAME=Enterprise Intelligent Log Analysis Platform
LOG_FILE_PATH=data/samples
REPORT_FILE_PATH=logs/log_summary.csv
SUMMARY_FILE_PATH=logs/analytics_summary.json
LOG_LEVEL=INFO
# Expected share of records the Isolation Forest flags as anomalous (0 < value <= 0.5).
ANOMALY_CONTAMINATION=0.02

# Incident summaries are disabled until explicitly enabled.
INCIDENT_SUMMARY_ENABLED=false
INCIDENT_SUMMARY_PROVIDER=openai
# Optional custom API base URL; defaults to the selected provider's official API.
INCIDENT_SUMMARY_API_BASE=
# Use the selected provider key, or INCIDENT_SUMMARY_API_KEY as a generic override.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
INCIDENT_SUMMARY_API_KEY=
INCIDENT_SUMMARY_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
GEMINI_MODEL=gemini-3.5-flash-lite
INCIDENT_SUMMARY_TIMEOUT_SECONDS=30

# --- Live monitoring: python main.py --monitor ---------------------------------
# Magento var/log directory to watch (docker-magento bind-mounts it to src/var/log).
MAGENTO_LOG_DIR=
MONITOR_DB_PATH=data/monitor.db
MONITOR_POLL_SECONDS=2
ALERT_COOLDOWN_MINUTES=15
ALERT_SPIKE_WINDOW_MINUTES=5
ALERT_SPIKE_MIN_ERRORS=10
ALERT_SPIKE_FACTOR=3

# Optional e-mail alerts. For Gmail create an app password (Google Account > Security).
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
# low | medium | high | critical
ALERT_EMAIL_MIN_SEVERITY=high
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
